widget "Bitcoin Pulse · Compact" {
  meta { owl: 8; version: "5.0"; description: "Bitcoin price, candles and mainnet blocks. Public data from Kraken and mempool.space; no Linux required." }
  size: 2x2
  minSize: 1x1
  padding: 0
  state currency = "EUR" persist
  state interval = 240 persist
  state interval2 = 1440 persist
  state graphCount = 2 persist
  state picker = -1
  state ichimoku = false persist
  state zoom4h = 36 persist
  state zoomDay = 36 persist
  state zoomWeek = 36 persist
  let initialWidth = 160
  let initialHeight = 160
  let adaptiveWidth = tileWidth ?? initialWidth
  let adaptiveHeight = tileHeight ?? initialHeight
  let viewMode = adaptiveWidth >= 250 && adaptiveHeight >= 320 ? "network" : adaptiveWidth >= 160 && adaptiveHeight >= 160 ? "compact" : "mini"
  on (viewMode) { picker = -1 }
  source now = clock every 1s
  source ticker = http("https://api.kraken.com/0/public/Ticker?pair=XBTEUR,XBTUSD") every 1m json status
  source blocks = http("https://mempool.space/api/v1/blocks") every 1m json status
  source fees = http("https://mempool.space/api/v1/fees/recommended") every 1m json status
  source pool = http(viewMode == "network" || viewMode == "compact" && adaptiveHeight >= 300 ? "https://mempool.space/api/mempool" : null) every 1m json status
  source eur4h = http(viewMode == "network" && currency == "EUR" && (interval == 240 || graphCount == 2 && interval2 == 240) ? "https://api.kraken.com/0/public/OHLC?pair=XBTEUR&interval=240" : null) every 5m json status
  source eurDay = http(viewMode == "network" && currency == "EUR" && (interval == 1440 || graphCount == 2 && interval2 == 1440) ? "https://api.kraken.com/0/public/OHLC?pair=XBTEUR&interval=1440" : null) every 5m json status
  source eurWeek = http(viewMode == "network" && currency == "EUR" && (interval == 10080 || graphCount == 2 && interval2 == 10080) ? "https://api.kraken.com/0/public/OHLC?pair=XBTEUR&interval=10080" : null) every 5m json status
  source usd4h = http(viewMode == "network" && currency == "USD" && (interval == 240 || graphCount == 2 && interval2 == 240) ? "https://api.kraken.com/0/public/OHLC?pair=XBTUSD&interval=240" : null) every 5m json status
  source usdDay = http(viewMode == "network" && currency == "USD" && (interval == 1440 || graphCount == 2 && interval2 == 1440) ? "https://api.kraken.com/0/public/OHLC?pair=XBTUSD&interval=1440" : null) every 5m json status
  source usdWeek = http(viewMode == "network" && currency == "USD" && (interval == 10080 || graphCount == 2 && interval2 == 10080) ? "https://api.kraken.com/0/public/OHLC?pair=XBTUSD&interval=10080" : null) every 5m json status
  state quotes = null persist
  state priceAt = null persist
  state block = null persist
  state blockAt = null persist
  state advice = null persist
  state feesAt = null persist
  state mem = null persist
  state memAt = null persist
  on (ticker ?? false) { quotes = ticker.ok && ticker.out.result != null && len(ticker.out.error) == 0 ? ticker.out.result : quotes; priceAt = ticker.ok && ticker.out.result != null && len(ticker.out.error) == 0 ? now : priceAt }
  on (blocks ?? false) { block = blocks.ok && blocks.out[0].height != null ? blocks.out[0] : block; blockAt = blocks.ok && blocks.out[0].height != null ? now : blockAt }
  on (fees ?? false) { advice = fees.ok && fees.out.fastestFee != null ? fees.out : advice; feesAt = fees.ok && fees.out.fastestFee != null ? now : feesAt }
  on (pool ?? false) { mem = pool.ok && pool.out.count != null ? pool.out : mem; memAt = pool.ok && pool.out.count != null ? now : memAt }
  let key = currency == "EUR" ? "XXBTZEUR" : "XXBTZUSD"
  state cacheeur4h = [] persist
  state timeeur4h = null persist
  let rowseur4h = get(eur4h.out.result, "XXBTZEUR")
  on (eur4h ?? false) {
    cacheeur4h = eur4h.ok && len(eur4h.out.error) == 0 && len(rowseur4h) > 0 ? reverse(take(reverse(rowseur4h), 480)) : cacheeur4h
    timeeur4h = eur4h.ok && len(eur4h.out.error) == 0 && len(rowseur4h) > 0 ? now : timeeur4h
  }
  state cacheeurDay = [] persist
  state timeeurDay = null persist
  let rowseurDay = get(eurDay.out.result, "XXBTZEUR")
  on (eurDay ?? false) {
    cacheeurDay = eurDay.ok && len(eurDay.out.error) == 0 && len(rowseurDay) > 0 ? reverse(take(reverse(rowseurDay), 480)) : cacheeurDay
    timeeurDay = eurDay.ok && len(eurDay.out.error) == 0 && len(rowseurDay) > 0 ? now : timeeurDay
  }
  state cacheeurWeek = [] persist
  state timeeurWeek = null persist
  let rowseurWeek = get(eurWeek.out.result, "XXBTZEUR")
  on (eurWeek ?? false) {
    cacheeurWeek = eurWeek.ok && len(eurWeek.out.error) == 0 && len(rowseurWeek) > 0 ? reverse(take(reverse(rowseurWeek), 480)) : cacheeurWeek
    timeeurWeek = eurWeek.ok && len(eurWeek.out.error) == 0 && len(rowseurWeek) > 0 ? now : timeeurWeek
  }
  state cacheusd4h = [] persist
  state timeusd4h = null persist
  let rowsusd4h = get(usd4h.out.result, "XXBTZUSD")
  on (usd4h ?? false) {
    cacheusd4h = usd4h.ok && len(usd4h.out.error) == 0 && len(rowsusd4h) > 0 ? reverse(take(reverse(rowsusd4h), 480)) : cacheusd4h
    timeusd4h = usd4h.ok && len(usd4h.out.error) == 0 && len(rowsusd4h) > 0 ? now : timeusd4h
  }
  state cacheusdDay = [] persist
  state timeusdDay = null persist
  let rowsusdDay = get(usdDay.out.result, "XXBTZUSD")
  on (usdDay ?? false) {
    cacheusdDay = usdDay.ok && len(usdDay.out.error) == 0 && len(rowsusdDay) > 0 ? reverse(take(reverse(rowsusdDay), 480)) : cacheusdDay
    timeusdDay = usdDay.ok && len(usdDay.out.error) == 0 && len(rowsusdDay) > 0 ? now : timeusdDay
  }
  state cacheusdWeek = [] persist
  state timeusdWeek = null persist
  let rowsusdWeek = get(usdWeek.out.result, "XXBTZUSD")
  on (usdWeek ?? false) {
    cacheusdWeek = usdWeek.ok && len(usdWeek.out.error) == 0 && len(rowsusdWeek) > 0 ? reverse(take(reverse(rowsusdWeek), 480)) : cacheusdWeek
    timeusdWeek = usdWeek.ok && len(usdWeek.out.error) == 0 && len(rowsusdWeek) > 0 ? now : timeusdWeek
  }
  let quote = get(quotes, key)
  let price = num(quote.c[0])
  let opening = num(quote.o)
  let change = opening > 0 ? (price - opening) / opening * 100 : null
  let symbol = currency == "EUR" ? "€" : "$"
  let periods = [interval, interval2]
  let histories = map(periods, p => currency == "EUR" ? (p == 240 ? cacheeur4h : p == 1440 ? cacheeurDay : cacheeurWeek) : (p == 240 ? cacheusd4h : p == 1440 ? cacheusdDay : cacheusdWeek))
  let candleTimes = map(periods, p => currency == "EUR" ? (p == 240 ? timeeur4h : p == 1440 ? timeeurDay : timeeurWeek) : (p == 240 ? timeusd4h : p == 1440 ? timeusdDay : timeusdWeek))
  let zoomCounts = map(periods, p => p == 240 ? zoom4h : p == 1440 ? zoomDay : zoomWeek)
  let charts = map(range(2), slot => reverse(take(reverse(histories[slot]), zoomCounts[slot])))
  let allHighs = map(histories, h => map(h, c => num(c[2])))
  let allLows = map(histories, h => map(h, c => num(c[3])))
  let clouds = map(range(2), slot => ichimoku && len(charts[slot]) > 0 && len(histories[slot]) >= 148 + len(charts[slot]) ? map(range(max(119, len(histories[slot]) - len(charts[slot]) - 29), len(histories[slot])), i => {index: i + 29 - (len(histories[slot]) - len(charts[slot])), a: (max(take(drop(allHighs[slot], i - 19), 20)) + min(take(drop(allLows[slot], i - 19), 20)) + max(take(drop(allHighs[slot], i - 59), 60)) + min(take(drop(allLows[slot], i - 59), 60))) / 4, b: (max(take(drop(allHighs[slot], i - 119), 120)) + min(take(drop(allLows[slot], i - 119), 120))) / 2}) : [])
  let stale = priceAt == null || blockAt == null || feesAt == null || memAt == null || now - priceAt > 180 || now - blockAt > 180 || now - feesAt > 180 || now - memAt > 180
  let failed = ticker.ok == false || len(ticker.out.error) > 0 || blocks.ok == false || fees.ok == false || pool.ok == false
  onTap: androidApp("com.buildapptest.bitcoinpulse")
  background: #00000000
  let whole = price == null ? "" : first(split(fixed(price, 2), "."))
  let grouped = join(reverse(map(range(ceil(len(whole) / 3)), i => sub(whole, max(0, len(whole) - (i + 1) * 3), len(whole) - i * 3))), ".")
  let priceText = price == null ? "Koers laden…" : "${symbol} ${grouped},${last(split(fixed(price, 2), '.'))}"
  let heightDigits = block == null ? "" : str(int(block.height))
  let heightText = block == null ? "—" : join(reverse(map(range(ceil(len(heightDigits) / 3)), i => sub(heightDigits, max(0, len(heightDigits) - (i + 1) * 3), len(heightDigits) - i * 3))), ".")
  let txDigits = block == null ? "" : str(int(block.tx_count))
  let txText = block == null ? "—" : join(reverse(map(range(ceil(len(txDigits) / 3)), i => sub(txDigits, max(0, len(txDigits) - (i + 1) * 3), len(txDigits) - i * 3))), ".")
  let lastChange = priceAt != null && blockAt != null ? min(priceAt, blockAt) : null
  let single = graphCount == 1
  let dense = single || tileHeight < 760
  let plotSize = dense ? max((tileHeight - 243 - 36 * (graphCount - 1)) / graphCount, 40) : 116
  let shortPrice = price >= 1000 ? round(price / 1000, 1) : round(price)
  let miniPriceText = price == null ? "${symbol} —" : "${symbol} ${replace(str(shortPrice), '.', ',')}${price >= 1000 ? 'k' : ''}"
  let feeText = advice.fastestFee == null ? "— sat/vB" : "${replace(str(num(advice.fastestFee)), '.', ',')} sat/vB"
  let w = adaptiveWidth
  let h = adaptiveHeight
  let inset = min(w, h) < 60 ? 4 : 6
  let available = max(w - 2 * inset - 1, 1)
  let miniGrowth = min(max(min(w, h) / 80, 1), 1.5)
  let blockSize = min((w < 76 ? 14 : 15) * miniGrowth, available / max(len(heightText) * 0.6, 1))
  let feeSize = min((w < 76 ? 11 : 12) * miniGrowth, available / max(len(feeText) * 0.6, 1))
  let priceSize = min(12 * miniGrowth, available / max(len(miniPriceText) * 0.6, 1))
  let labelSize = (w < 76 ? 9 : 10) * miniGrowth
  let showPrice = w >= 76 && h >= 2 * inset + (labelSize + blockSize + feeSize + priceSize) * 1.2 + 6
  let showLabel = h >= 48 && h >= 2 * inset + (labelSize + blockSize + feeSize) * 1.2 + 4
  let oldBlock = block != null && (blocks.ok == false || blockAt == null || now - blockAt > 1200)
  let oldFees = advice != null && (fees.ok == false || feesAt == null || now - feesAt > 1200)
  let oldPrice = showPrice && quotes != null && (ticker.ok == false || priceAt == null || now - priceAt > 1200)
  let compactChange = adaptiveHeight >= 220
  let compactEstimates = adaptiveHeight >= 280
  let compactMore = adaptiveHeight >= 240
  let compactDetails = adaptiveHeight >= 300
  let compactGrowth = min(max((min(adaptiveWidth, adaptiveHeight) - 160) / 140, 0), 1)
  let compactPriceText = adaptiveWidth >= 240 ? priceText : miniPriceText
  let compactPriceSize = min(26 + 6 * compactGrowth, (adaptiveWidth - 21) / max(len(compactPriceText) * 0.6, 1))
  let compactTx = "${txText} tx · ${block.extras.pool.name ?? '—'}"
  let compactMedian = block.extras.medianFee == null ? "Mediaan blokfee — sat/vB" : "Mediaan blokfee ${replace(fixed(block.extras.medianFee, 1), '.', ',')} sat/vB"
  let compactMemDigits = mem == null ? "" : str(int(mem.count))
  let compactMemCount = mem == null ? "—" : join(reverse(map(range(ceil(len(compactMemDigits) / 3)), i => sub(compactMemDigits, max(0, len(compactMemDigits) - (i + 1) * 3), len(compactMemDigits) - i * 3))), ".")
  let compactMempool = mem == null ? "Mempool —" : "Mempool ${compactMemCount} tx · ${replace(fixed(mem.vsize / 1000000, 1), '.', ',')} vMB"
  let compactAt = priceAt != null && blockAt != null && feesAt != null && (!compactDetails || memAt != null) ? min(priceAt, blockAt, feesAt, compactDetails ? memAt : feesAt) : null
  let compactStatus = oldBlock || oldFees || compactDetails && mem != null && (pool.ok == false || now - memAt > 1200) || quotes != null && (ticker.ok == false || now - priceAt > 1200) ? "Oudere gegevens · ${fmtTime(compactAt, 'HH:mm')}" : compactAt == null ? "Gegevens laden…" : "Bijgewerkt ${fmtTime(compactAt, 'HH:mm')}"
  if viewMode == "mini" {
  Column {
    fill: true
    padding: inset
    background: #182230
    radius: 16
    gap: 2
    justify: center
    onTap: currency = currency == "EUR" ? "USD" : "EUR"
    if showLabel { Text { text: oldBlock || oldFees || oldPrice ? "Blok · oud" : "Blok"; font: sans; fontSize: labelSize; color: #BAC7DB; maxLines: 1 } }
    Text { text: heightText; font: sans; fontSize: blockSize; bold: true; color: #49CFFF; maxLines: 1 }
    Text { text: feeText; font: sans; fontSize: feeSize; bold: true; color: #FF8A1F; maxLines: 1 }
    if showPrice { Text { text: miniPriceText; font: sans; fontSize: priceSize; bold: true; color: #F7FAFF; maxLines: 1 } }
  }
  } else if viewMode == "compact" {
  Column {
    fill: true
    padding: 10
    background: #182230
    radius: 28
    gap: 2
    Row {
      fill: width
      height: 48
      align: center
      Text { text: "BTC/${currency} ▾"; weight: 1; font: sans; fontSize: 12; color: #BAC7DB; maxLines: 1; onTap: currency = currency == "EUR" ? "USD" : "EUR" }
      Box { width: 48; height: 48; background: #243246; radius: 16; align: center; onTap: refresh(); Text { text: "↻"; font: sans; fontSize: 24; color: #FF8A1F; align: center; maxLines: 1 } }
    }
    Text { text: compactPriceText; font: sans; fontSize: compactPriceSize; bold: true; color: #F7FAFF; maxLines: 1 }
    Text { text: "Blok #${heightText}"; font: sans; fontSize: min(15 + 2 * compactGrowth, (adaptiveWidth - 21) / max(len(heightText) * 0.6 + 3, 1)); bold: true; color: #49CFFF; maxLines: 1 }
    Text { text: feeText; font: sans; fontSize: 14 + compactGrowth; bold: true; color: #FF8A1F; maxLines: 1 }
    if compactChange { Text { text: change == null ? "—% vandaag (UTC)" : "${replace(fixed(change, 2), '.', ',')}% vandaag (UTC)"; font: sans; fontSize: 12; color: change < 0 ? #FF647C : #35E89A; maxLines: 1 } }
    if compactMore {
      Text { text: block == null ? "— geleden" : "${fmtDuration(max(now - block.timestamp, 0))} geleden"; font: sans; fontSize: 12; color: #BAC7DB; maxLines: 1 }
      Text { text: compactTx; font: sans; fontSize: min(12, (adaptiveWidth - 21) / max(len(compactTx) * 0.55, 1)); color: #BAC7DB; maxLines: 1 }
    }
    if compactDetails {
      Text { text: compactMedian; font: sans; fontSize: min(12, (adaptiveWidth - 21) / max(len(compactMedian) * 0.5, 1)); color: #BAC7DB; maxLines: 1 }
      Text { text: compactMempool; font: sans; fontSize: min(12, (adaptiveWidth - 21) / max(len(compactMempool) * 0.55, 1)); color: #BAC7DB; maxLines: 1 }
    }
    if compactEstimates {
      Text { text: "~30 min · ${advice.halfHourFee == null ? '—' : replace(str(num(advice.halfHourFee)), '.', ',')} sat/vB"; font: sans; fontSize: 12; color: #BAC7DB; maxLines: 1 }
      Text { text: "~1 uur · ${advice.hourFee == null ? '—' : replace(str(num(advice.hourFee)), '.', ',')} sat/vB"; font: sans; fontSize: 12; color: #BAC7DB; maxLines: 1 }
    }
    Column { weight: 1; fill: width; justify: end; Text { text: compactStatus; font: sans; fontSize: min(11, (adaptiveWidth - 21) / max(len(compactStatus) * 0.55, 1)); color: #BAC7DB; maxLines: 1 } }
  }
  } else {
  Column {
    fill: true
    padding: dense ? 8 : 14
    background: #182230
    radius: 28
    gap: single ? 2 : dense ? 4 : 6
    scroll: !single
    if dense {
      Row {
        fill: width
        height: 34
        align: center
        Text { weight: 1; text: priceText; font: sans; fontSize: 26; bold: true; color: #F7FAFF; maxLines: 1 }
        Box { width: 60; height: 32; align: center; background: #243246; radius: 12; border: 1; borderColor: #38485F; onTap: currency = currency == "EUR" ? "USD" : "EUR"; Text { text: "${currency} ▾"; font: sans; fontSize: 12; color: #BAC7DB; align: center; maxLines: 1 } }
      }
      Row {
        fill: width
        height: 32
        align: center
        Column {
          weight: 1
          gap: 0
          Text { text: change == null ? "Kraken · wacht op koers" : "${replace(fixed(change, 2), '.', ',')}% vandaag (UTC) · Kraken"; font: sans; fontSize: 10; color: change < 0 ? #FF647C : #35E89A; maxLines: 1 }
          if single { Text { text: "Ichimoku 20 / 60 / 120 / 30"; font: sans; fontSize: 9; color: #BAC7DB; maxLines: 1 } }
        }
        Box { width: 76; height: 32; align: center; background: #243246; radius: 24; border: 1; borderColor: ichimoku ? #FF8A1F : #38485F; onTap: ichimoku = !ichimoku; Text { text: ichimoku ? "Cloud Aan" : "Cloud Uit"; font: sans; fontSize: 12; color: ichimoku ? #FF8A1F : #BAC7DB; align: center; maxLines: 1 } }
      }
    } else {
    Row {
      fill: width
      gap: 8
      Column {
        weight: 1
        gap: 2
        Text { text: "Bitcoin Pulse"; font: sans; fontSize: 13; color: #BAC7DB; maxLines: 1 }
        Text { text: priceText; font: sans; fontSize: tileWidth < 340 ? 28 : 32; bold: true; color: #F7FAFF; maxLines: 1 }
      }
      Box {
        width: 60
        height: 48
        align: center
        background: #243246
        border: 1
        borderColor: #38485F
        radius: 12
        onTap: currency = currency == "EUR" ? "USD" : "EUR"
        Text { text: "${currency} ▾"; font: sans; fontSize: 13; color: #BAC7DB; align: center; maxLines: 1 }
      }
    }
    Text { text: change == null ? "Kraken · wacht op koers" : "${replace(fixed(change, 2), '.', ',')}% vandaag (UTC) · Kraken"; font: sans; fontSize: 12; color: change < 0 ? #FF647C : #35E89A; maxLines: 1 }
    Row {
      fill: width
      gap: 8
      align: center
      Column {
        weight: 1
        gap: 2
        Text { text: "Ichimoku cloud"; font: sans; fontSize: 13; color: #F7FAFF; maxLines: 1 }
        Text { text: "20 / 60 / 120 / 30"; font: sans; fontSize: 11; color: #BAC7DB; maxLines: 1 }
      }
      Box {
        width: 76
        height: 48
        align: center
        background: #243246
        border: 1
        borderColor: ichimoku ? #FF8A1F : #38485F
        radius: 24
        onTap: ichimoku = !ichimoku
        Text { text: ichimoku ? "Cloud Aan" : "Cloud Uit"; font: sans; fontSize: 12; color: ichimoku ? #FF8A1F : #BAC7DB; align: center; maxLines: 1 }
      }
    }
    }
    for slot in range(graphCount) {
      let period = periods[slot]
      let history = histories[slot]
      let candleAt = candleTimes[slot]
      let ohlc = currency == "EUR" ? (period == 240 ? eur4h : period == 1440 ? eurDay : eurWeek) : (period == 240 ? usd4h : period == 1440 ? usdDay : usdWeek)
      let zoomCount = zoomCounts[slot]
      let chart = charts[slot]
      let cloudRequired = 148 + len(chart)
      let cloudReady = ichimoku && len(chart) > 0 && len(history) >= cloudRequired
      let cloudPoints = clouds[slot]
      let rawLow = cloudReady ? min(min(map(chart, c => num(c[3]))), min(map(cloudPoints, p => min(p.a, p.b)))) : min(map(chart, c => num(c[3])))
      let rawHigh = cloudReady ? max(max(map(chart, c => num(c[2]))), max(map(cloudPoints, p => max(p.a, p.b)))) : max(map(chart, c => num(c[2])))
      let pad = max((rawHigh - rawLow) * 0.08, rawHigh * 0.0001)
      let low = rawLow - pad
      let high = rawHigh + pad
      let span = max(high - low, 1)
    Row {
      fill: width
      align: center
      gap: 3
      Box {
        weight: 1
        height: dense ? 32 : 40
        align: center
        background: #243246
        radius: 9
        onTap: picker = picker == slot ? -1 : slot
        Text { text: "${period == 240 ? '4 uur' : period == 1440 ? '1 dag' : '1 week'} ▾"; font: sans; fontSize: 12; color: #F7FAFF; align: center; maxLines: 1 }
      }
      Box {
        width: dense ? 36 : 40
        height: dense ? 32 : 40
        align: center
        onTap: {
          zoom4h = period == 240 ? (zoom4h < 36 ? 36 : zoom4h < 60 ? 60 : zoom4h < 90 ? 90 : zoom4h < 120 ? 120 : zoom4h < 180 ? 180 : 270) : zoom4h
          zoomDay = period == 1440 ? (zoomDay < 36 ? 36 : zoomDay < 60 ? 60 : zoomDay < 90 ? 90 : zoomDay < 120 ? 120 : zoomDay < 180 ? 180 : 270) : zoomDay
          zoomWeek = period == 10080 ? (zoomWeek < 36 ? 36 : zoomWeek < 60 ? 60 : zoomWeek < 90 ? 90 : zoomWeek < 120 ? 120 : zoomWeek < 180 ? 180 : 270) : zoomWeek
        }
        Box { width: dense ? 26 : 30; height: dense ? 22 : 30; radius: 8; opacity: zoomCount >= 270 ? 0.3 : 1; background: #243246; border: 1; borderColor: #38485F }
        Text { text: "−"; font: sans; fontSize: 20; color: #FF8A1F; opacity: zoomCount >= 270 ? 0.3 : 1; align: center }
      }
      Text { width: 26; text: str(len(chart)); font: sans; fontSize: 11; color: #BAC7DB; align: center; maxLines: 1 }
      Box {
        width: dense ? 36 : 40
        height: dense ? 32 : 40
        align: center
        onTap: {
          zoom4h = period == 240 ? (zoom4h > 180 ? 180 : zoom4h > 120 ? 120 : zoom4h > 90 ? 90 : zoom4h > 60 ? 60 : zoom4h > 36 ? 36 : 24) : zoom4h
          zoomDay = period == 1440 ? (zoomDay > 180 ? 180 : zoomDay > 120 ? 120 : zoomDay > 90 ? 90 : zoomDay > 60 ? 60 : zoomDay > 36 ? 36 : 24) : zoomDay
          zoomWeek = period == 10080 ? (zoomWeek > 180 ? 180 : zoomWeek > 120 ? 120 : zoomWeek > 90 ? 90 : zoomWeek > 60 ? 60 : zoomWeek > 36 ? 36 : 24) : zoomWeek
        }
        Box { width: dense ? 26 : 30; height: dense ? 22 : 30; radius: 8; opacity: zoomCount <= 24 ? 0.3 : 1; background: #243246; border: 1; borderColor: #38485F }
        Text { text: "+"; font: sans; fontSize: 20; color: #FF8A1F; opacity: zoomCount <= 24 ? 0.3 : 1; align: center }
      }
    }
    if picker == slot {
      Row {
        fill: width
        gap: 3
        for p in [240, 1440, 10080] {
          let available = graphCount == 1 || p != periods[1 - slot]
          Box {
            weight: 1
            height: dense ? 32 : 40
            align: center
            background: #243246
            radius: 8
            onTap: { interval = slot == 0 && available ? p : interval; interval2 = slot == 1 && available ? p : interval2; picker = available ? -1 : picker }
            Text { text: p == 240 ? "4 uur" : p == 1440 ? "1 dag" : "1 week"; font: sans; fontSize: 12; color: !available ? #718096 : p == period ? #FF8A1F : #F7FAFF; align: center; maxLines: 1 }
          }
        }
      }
    }
    if len(chart) > 0 {
      Canvas {
        fill: width
        height: single ? null : plotSize
        weight: single ? 1 : 0
        let plotWidth = max(width - 68, 1)
        let plotHeight = height - (height < 90 ? 23 : 35)
        let top = height < 90 ? 6 : 10
        let step = plotWidth / max(len(chart) + (cloudReady ? 29 : 0), 1)
        for j in [0, 1, 2] {
          let axisValue = high - span * j / 2
          let axisDigits = str(int(round(axisValue)))
          let axisText = "${replace(fixed(axisValue / 1000, 1), '.', ',')}k"
          line(3, top + j * plotHeight / 2, 3 + plotWidth, top + j * plotHeight / 2, stroke: #38485F, width: 0.6)
          text(axisText, width - 2, top + j * plotHeight / 2, size: height < 90 ? 9 : 11, align: end, color: #BAC7DB)
        }
        let points = cloudPoints
        if len(points) > 1 {
          let edges = map(range(len(points)), j => {p: points[j], q: points[j + 1], t: j + 1 < len(points) && (points[j].a - points[j].b) * (points[j + 1].a - points[j + 1].b) < 0 ? (points[j].a - points[j].b) / ((points[j].a - points[j].b) - (points[j + 1].a - points[j + 1].b)) : null})
          let fillPoints = flatten(map(edges, r => r.t == null ? [r.p] : [r.p, {index: r.p.index + r.t, a: r.p.a + (r.q.a - r.p.a) * r.t, b: r.p.a + (r.q.a - r.p.a) * r.t}]))
          path(flatten([map(fillPoints, p => [3 + (p.index + 0.5) * step, top + (high - p.a) / span * plotHeight]), reverse(map(fillPoints, p => [3 + (p.index + 0.5) * step, top + (high - min(p.a, p.b)) / span * plotHeight]))]), closed: true, fill: alpha(#43A047,0.26))
          path(flatten([map(fillPoints, p => [3 + (p.index + 0.5) * step, top + (high - p.a) / span * plotHeight]), reverse(map(fillPoints, p => [3 + (p.index + 0.5) * step, top + (high - max(p.a, p.b)) / span * plotHeight]))]), closed: true, fill: alpha(#F23645,0.26))
          for p, j in points {
            if j < len(points) - 1 {
              let q = points[j + 1]
              line(3 + (p.index + 0.5) * step, top + (high - p.a) / span * plotHeight, 3 + (q.index + 0.5) * step, top + (high - q.a) / span * plotHeight, stroke: #A5D6A7, width: 1)
              line(3 + (p.index + 0.5) * step, top + (high - p.b) / span * plotHeight, 3 + (q.index + 0.5) * step, top + (high - q.b) / span * plotHeight, stroke: #EF9A9A, width: 1)
            }
          }
        }
        for c, i in chart {
          let x = 3 + (i + 0.5) * step
          let openY = top + (high - num(c[1])) / span * plotHeight
          let closeY = top + (high - num(c[4])) / span * plotHeight
          let rising = num(c[4]) >= num(c[1])
          line(x, top + (high - num(c[2])) / span * plotHeight, x, top + (high - num(c[3])) / span * plotHeight, stroke: rising ? #35E89A : #FF647C, width: 1)
          rect(x - step * 0.28, min(openY, closeY), step * 0.56, max(abs(openY - closeY), 2), fill: rising ? #182230 : #FF647C, stroke: rising ? #35E89A : #FF647C, width: 1)
          if i == len(chart) - 1 { circle(x, top - 5, 2, fill: rising ? #35E89A : #FF647C) }
        }
        text(fmtTime(num(first(chart)[0]), "d MMM"), 3, height - (height < 90 ? 3 : 11), size: height < 90 ? 9 : 11, color: #BAC7DB)
        if !cloudReady {
          text(fmtTime(num(chart[floor(len(chart) / 2)][0]), "d MMM"), 3 + plotWidth / 2, height - (height < 90 ? 3 : 11), size: height < 90 ? 9 : 11, align: center, color: #BAC7DB)
        }
        if cloudReady {
          text(fmtTime(num(last(chart)[0]), "d MMM"), 3 + (len(chart) - 0.5) * step, height - (height < 90 ? 3 : 11), size: height < 90 ? 9 : 11, align: center, color: #BAC7DB)
          if len(chart) <= 90 { text("Cloud", 3 + plotWidth, height - (height < 90 ? 3 : 11), size: height < 90 ? 9 : 11, align: end, color: #BAC7DB) }
        } else {
          text(fmtTime(num(last(chart)[0]), "d MMM"), 3 + plotWidth, height - (height < 90 ? 3 : 11), size: height < 90 ? 9 : 11, align: end, color: #BAC7DB)
        }
        text(currency, width - 2, height - (height < 90 ? 3 : 11), size: height < 90 ? 9 : 11, align: end, color: #BAC7DB)
      }
      if !dense || single {
      Text { text: ichimoku && !cloudReady ? "Cloud: ${cloudRequired} candles nodig · vernieuw" : ohlc.ok == false ? "Cache · vernieuwen mislukt · ${fmtTime(candleAt, 'HH:mm')}" : "Laatste candle loopt nog · ${fmtTime(candleAt, 'HH:mm')}"; font: sans; fontSize: single ? 10 : 11; color: ohlc.ok == false || now - candleAt > 660 ? #FFD166 : #BAC7DB; maxLines: 1 }
      }
    } else {
      Box {
        fill: width
        weight: single ? 1 : 0
        height: single ? null : plotSize
        align: center
        Text { text: ohlc.ok == false || len(ohlc.out.error) > 0 ? "Candles niet beschikbaar · tik op ↻" : "Candles laden…"; font: sans; fontSize: 12; color: #FFD166; align: center; maxLines: 2 }
      }
    }
    }
    Column {
      fill: width
      gap: single ? 2 : 4
      padding: dense ? 6 : 10
      background: #243246
      radius: 14
      Row {
        fill: width
        gap: 6
        Text { text: "Blok #${heightText}"; weight: 1; font: sans; fontSize: dense ? 13 : 15; bold: true; color: #49CFFF; maxLines: 1 }
        Text { text: block == null ? "—" : "${fmtDuration(max(now - block.timestamp, 0))} geleden"; weight: 1; font: sans; fontSize: dense ? 11 : 12; color: #F7FAFF; align: end; maxLines: 1 }
      }
      Text { text: "${txText} transacties · ${block.extras.pool.name ?? 'Onbekende pool'}"; font: sans; fontSize: dense ? 11 : 12; color: #BAC7DB; maxLines: 1 }
      if !dense || single { Text { text: block.extras.medianFee == null ? "Mediaan blokfee —" : "Mediaan blokfee ${replace(fixed(block.extras.medianFee, 1), '.', ',')} sat/vB"; font: sans; fontSize: single ? 11 : 12; color: #BAC7DB; maxLines: 1 } }
    }
    Column {
      fill: width
      gap: 4
      if !dense || single { Text { text: "Fee-advies · schatting"; font: sans; fontSize: single ? 9 : 11; color: #BAC7DB; maxLines: 1 } }
      Row {
        fill: width
        gap: 6
        for f, i in [advice.fastestFee, advice.halfHourFee, advice.hourFee] {
          Column {
            weight: 1
            gap: dense ? 0 : 1
            Text { text: f == null ? "— sat/vB" : "${replace(str(num(f)), '.', ',')} sat/vB"; font: sans; fontSize: dense ? 13 : 16; bold: true; color: i == 0 ? #FF8A1F : #F7FAFF; maxLines: 1 }
            Text { text: i == 0 ? "Volgend blok" : i == 1 ? "~30 min" : "~1 uur"; font: sans; fontSize: dense ? 10 : 11; color: #BAC7DB; maxLines: 1 }
          }
        }
      }
    }
    if !dense { Box { fill: width; height: 1; background: #38485F } }
if !dense || single { Text { text: mem == null ? "Mempool laden…" : "Mempool ${join(reverse(map(range(ceil(len(str(int(mem.count))) / 3)), i => sub(str(int(mem.count)), max(0, len(str(int(mem.count))) - (i + 1) * 3), len(str(int(mem.count))) - i * 3))), '.')} tx · ${replace(fixed(mem.vsize / 1000000, 1), '.', ',')} vMB"; font: sans; fontSize: single ? 11 : 12; color: #BAC7DB; maxLines: 1 } }
    Row {
      fill: width
      gap: 4
      align: center
      Column {
        weight: 1
        gap: 2
        Text { text: failed ? "Bron niet bereikbaar · vorige waarden" : stale ? "Oudere waarden · controleer met ↻" : "Gewijzigd ${fmtTime(lastChange, 'HH:mm')}"; font: sans; fontSize: dense ? 10 : 12; color: failed || stale ? #FFD166 : #BAC7DB; maxLines: 1 }
        if !dense || single { Text { text: single ? "Bitcoin Pulse · mempool.space · Kraken" : "mempool.space · Kraken"; font: sans; fontSize: single ? 9 : 11; color: #BAC7DB; maxLines: 1 } }
      }
      Box {
        width: 40
        height: 32
        align: center
        background: #243246
        radius: 9
        onTap: { graphCount = graphCount == 1 ? 2 : 1; interval2 = graphCount == 2 && interval2 == interval ? (interval == 240 ? 1440 : 240) : interval2; picker = -1 }
        Text { text: "${graphCount} ↔"; font: sans; fontSize: 12; color: #FF8A1F; align: center; maxLines: 1 }
      }
      Box {
        width: dense ? 40 : 48
        height: dense ? 32 : 48
        align: center
        background: #243246
        border: 1
        borderColor: #38485F
        radius: 14
        onTap: refresh()
        Text { text: "↻"; font: sans; fontSize: single ? 22 : dense ? 25 : 30; color: #FF8A1F; align: center; maxLines: 1 }
      }
    }
  }
  }
}
