<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_background" android:contentDescription="@string/open_app">
  <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_price" style="@style/WidgetNumber" android:layout_width="0dp" android:layout_weight="1" android:textSize="26sp" android:textStyle="bold" android:text="—"/>
    <TextView android:id="@+id/widget_currency" style="@style/WidgetLabel" android:layout_width="60dp" android:layout_height="32dp" android:gravity="center" android:background="@drawable/widget_currency_frame" android:text="EUR ▾"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/widget_change" style="@style/WidgetLabel" android:layout_width="0dp" android:layout_weight="1" android:textSize="10sp"/>
    <TextView android:id="@+id/widget_ichimoku" style="@style/WidgetLabel" android:layout_width="76dp" android:layout_height="32dp" android:gravity="center" android:background="@drawable/widget_cloud_off" android:text="Cloud Uit"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/chart_header_1" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
    <TextView android:id="@+id/chart_label_1" style="@style/WidgetLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp" android:gravity="center" android:background="@drawable/widget_choice_frame" android:layout_marginEnd="3dp" android:clickable="true" android:focusable="true"/>
    <TextView android:id="@+id/chart_minus_1" style="@style/ChartZoomButton" android:layout_width="36dp" android:layout_height="32dp" android:text="−"/>
    <TextView android:id="@+id/chart_count_1" style="@style/WidgetLabel" android:layout_width="26dp" android:gravity="center" android:textSize="11sp"/>
    <TextView android:id="@+id/chart_plus_1" style="@style/ChartZoomButton" android:layout_width="36dp" android:layout_height="32dp" android:text="+"/>
  </LinearLayout>
  <ImageView android:id="@+id/chart_image_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitXY" android:contentDescription="Candlegrafiek"/>
  <TextView android:id="@+id/chart_status_1" style="@style/WidgetLabel" android:visibility="gone"/>
  <LinearLayout android:id="@+id/chart_header_2" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
    <TextView android:id="@+id/chart_label_2" style="@style/WidgetLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp" android:gravity="center" android:background="@drawable/widget_choice_frame" android:layout_marginEnd="3dp" android:clickable="true" android:focusable="true"/>
    <TextView android:id="@+id/chart_minus_2" style="@style/ChartZoomButton" android:layout_width="36dp" android:layout_height="32dp" android:text="−"/>
    <TextView android:id="@+id/chart_count_2" style="@style/WidgetLabel" android:layout_width="26dp" android:gravity="center" android:textSize="11sp"/>
    <TextView android:id="@+id/chart_plus_2" style="@style/ChartZoomButton" android:layout_width="36dp" android:layout_height="32dp" android:text="+"/>
  </LinearLayout>
  <ImageView android:id="@+id/chart_image_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitXY" android:contentDescription="Candlegrafiek"/>
  <TextView android:id="@+id/chart_status_2" style="@style/WidgetLabel" android:visibility="gone"/>
  <TextView android:id="@+id/chart_hint" style="@style/WidgetLabel" android:visibility="gone"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="6dp" android:background="@drawable/widget_block_frame" android:layout_marginTop="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <TextView android:id="@+id/widget_block" style="@style/WidgetNumber" android:layout_width="0dp" android:layout_weight="1" android:textSize="13sp" android:textColor="#49CFFF"/>
      <TextView android:id="@+id/widget_age" style="@style/WidgetLabel" android:layout_width="0dp" android:layout_weight="1" android:gravity="end" android:textSize="11sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
      <TextView android:id="@+id/widget_tx" style="@style/WidgetLabel" android:textSize="11sp"/>
      <TextView android:id="@+id/widget_pool" style="@style/WidgetLabel" android:layout_width="0dp" android:layout_weight="1" android:textSize="11sp"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_median" style="@style/WidgetLabel" android:visibility="gone"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_fee_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
    <LinearLayout style="@style/FeeColumn" android:gravity="start"><TextView android:id="@+id/widget_next" android:textColor="#FF8A1F" style="@style/WidgetNumber" android:textSize="13sp"/><TextView style="@style/WidgetLabel" android:textSize="10sp" android:text="Volgend blok"/></LinearLayout>
    <LinearLayout style="@style/FeeColumn" android:gravity="start"><TextView android:id="@+id/widget_half" style="@style/WidgetNumber" android:textSize="13sp"/><TextView style="@style/WidgetLabel" android:textSize="10sp" android:text="~30 min"/></LinearLayout>
    <LinearLayout style="@style/FeeColumn" android:gravity="start"><TextView android:id="@+id/widget_hour" style="@style/WidgetNumber" android:textSize="13sp"/><TextView style="@style/WidgetLabel" android:textSize="10sp" android:text="~1 uur"/></LinearLayout>
  </LinearLayout>
  <TextView android:id="@+id/widget_mempool" style="@style/WidgetLabel" android:visibility="gone"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
    <TextView android:id="@+id/widget_updated" style="@style/WidgetLabel" android:layout_width="0dp" android:layout_weight="1" android:textSize="10sp"/>
    <TextView android:id="@+id/widget_refresh" style="@style/WidgetLabel" android:layout_width="40dp" android:layout_height="32dp" android:gravity="center" android:text="↻" android:textSize="25sp" android:textColor="#FF8A1F" android:background="@drawable/widget_refresh_frame" android:contentDescription="@string/refresh"/>
  </LinearLayout>
</LinearLayout>
