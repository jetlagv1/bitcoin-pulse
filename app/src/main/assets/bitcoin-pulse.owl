widget "Bitcoin Pulse" {
  meta { owl: 8; version: "3.1"; description: "Bitcoin price, candles and mainnet blocks. Public data from Kraken and mempool.space; no Linux required." }
  size: 6x10
  minSize: 6x10
  padding: 14
  state currency = "EUR" persist
  state interval = 240 persist
  state ichimoku = false persist
  state zoom4h = 36 persist
  state zoomDay = 36 persist
  state zoomWeek = 36 persist
  source now = clock every 1s
  source ticker = http("https://api.kraken.com/0/public/Ticker?pair=XBTEUR,XBTUSD") every 1m json status
  source blocks = http("https://mempool.space/api/v1/blocks") every 1m json status
  source fees = http("https://mempool.space/api/v1/fees/recommended") every 1m json status
  source pool = http("https://mempool.space/api/mempool") every 1m json status
  source eur4h = http(currency == "EUR" && interval == 240 ? "https://api.kraken.com/0/public/OHLC?pair=XBTEUR&interval=240" : null) every 5m json status
  source eurDay = http(currency == "EUR" && interval == 1440 ? "https://api.kraken.com/0/public/OHLC?pair=XBTEUR&interval=1440" : null) every 5m json status
  source eurWeek = http(currency == "EUR" && interval == 10080 ? "https://api.kraken.com/0/public/OHLC?pair=XBTEUR&interval=10080" : null) every 5m json status
  source usd4h = http(currency == "USD" && interval == 240 ? "https://api.kraken.com/0/public/OHLC?pair=XBTUSD&interval=240" : null) every 5m json status
  source usdDay = http(currency == "USD" && interval == 1440 ? "https://api.kraken.com/0/public/OHLC?pair=XBTUSD&interval=1440" : null) every 5m json status
  source usdWeek = http(currency == "USD" && interval == 10080 ? "https://api.kraken.com/0/public/OHLC?pair=XBTUSD&interval=10080" : null) every 5m json status
  let ohlc = currency == "EUR" ? (interval == 240 ? eur4h : interval == 1440 ? eurDay : eurWeek) : (interval == 240 ? usd4h : interval == 1440 ? usdDay : usdWeek)
  state quotes = null persist
  state priceAt = null persist
  state block = null persist
  state blockAt = null persist
  state advice = null persist
  state feesAt = null persist
  state mem = null persist
  state memAt = null persist
  state candles = null persist
  state candleAt = null persist
  state candleCurrency = "" persist
  state candleInterval = 0 persist
  on (ticker ?? false) { quotes = ticker.ok && ticker.out.result != null && len(ticker.out.error) == 0 ? ticker.out.result : quotes; priceAt = ticker.ok && ticker.out.result != null && len(ticker.out.error) == 0 ? now : priceAt }
  on (blocks ?? false) { block = blocks.ok && blocks.out[0].height != null ? blocks.out[0] : block; blockAt = blocks.ok && blocks.out[0].height != null ? now : blockAt }
  on (fees ?? false) { advice = fees.ok && fees.out.fastestFee != null ? fees.out : advice; feesAt = fees.ok && fees.out.fastestFee != null ? now : feesAt }
  on (pool ?? false) { mem = pool.ok && pool.out.count != null ? pool.out : mem; memAt = pool.ok && pool.out.count != null ? now : memAt }
  let key = currency == "EUR" ? "XXBTZEUR" : "XXBTZUSD"
  let incoming = get(ohlc.out.result, key)
  on (ohlc ?? false) {
    candles = ohlc.ok && len(incoming) > 0 ? reverse(take(reverse(incoming), 240)) : candles
    candleAt = ohlc.ok && len(incoming) > 0 ? now : candleAt
    candleCurrency = ohlc.ok && len(incoming) > 0 ? currency : candleCurrency
    candleInterval = ohlc.ok && len(incoming) > 0 ? interval : candleInterval
  }
  let quote = get(quotes, key)
  let price = num(quote.c[0])
  let opening = num(quote.o)
  let change = opening > 0 ? (price - opening) / opening * 100 : null
  let symbol = currency == "EUR" ? "€" : "$"
  let history = candleCurrency == currency && candleInterval == interval ? candles ?? [] : []
  let zoomCount = interval == 240 ? zoom4h : interval == 1440 ? zoomDay : zoomWeek
  let chart = reverse(take(reverse(history), zoomCount))
  let cloudRequired = 148 + len(chart)
  let cloudReady = ichimoku && len(chart) > 0 && len(history) >= cloudRequired
  let highs = map(history, c => num(c[2]))
  let lows = map(history, c => num(c[3]))
  let cloudPoints = cloudReady ? map(range(max(119, len(history) - len(chart) - 29), len(history)), i => {index: i + 29 - (len(history) - len(chart)), a: (max(take(drop(highs, i - 19), 20)) + min(take(drop(lows, i - 19), 20)) + max(take(drop(highs, i - 59), 60)) + min(take(drop(lows, i - 59), 60))) / 4, b: (max(take(drop(highs, i - 119), 120)) + min(take(drop(lows, i - 119), 120))) / 2}) : []
  let low = cloudReady ? min(min(map(chart, c => num(c[3]))), min(map(cloudPoints, p => min(p.a, p.b)))) : min(map(chart, c => num(c[3])))
  let high = cloudReady ? max(max(map(chart, c => num(c[2]))), max(map(cloudPoints, p => max(p.a, p.b)))) : max(map(chart, c => num(c[2])))
  let span = max(high - low, 1)
  let stale = priceAt == null || blockAt == null || feesAt == null || memAt == null || now - priceAt > 180 || now - blockAt > 180 || now - feesAt > 180 || now - memAt > 180
  let failed = ticker.ok == false || len(ticker.out.error) > 0 || blocks.ok == false || fees.ok == false || pool.ok == false
  onTap: androidApp("com.buildapptest.bitcoinpulse")
  background: #182230
  let whole = price == null ? "" : first(split(fixed(price, 2), "."))
  let grouped = join(reverse(map(range(ceil(len(whole) / 3)), i => sub(whole, max(0, len(whole) - (i + 1) * 3), len(whole) - i * 3))), ".")
  let priceText = price == null ? "Koers laden…" : "${symbol} ${grouped},${last(split(fixed(price, 2), '.'))}"
  let heightDigits = block == null ? "" : str(int(block.height))
  let heightText = block == null ? "—" : join(reverse(map(range(ceil(len(heightDigits) / 3)), i => sub(heightDigits, max(0, len(heightDigits) - (i + 1) * 3), len(heightDigits) - i * 3))), ".")
  let txDigits = block == null ? "" : str(int(block.tx_count))
  let txText = block == null ? "—" : join(reverse(map(range(ceil(len(txDigits) / 3)), i => sub(txDigits, max(0, len(txDigits) - (i + 1) * 3), len(txDigits) - i * 3))), ".")
  let lastChange = priceAt != null && blockAt != null ? min(priceAt, blockAt) : null
  Column {
    fill: width
    gap: 6
    scroll: true
    Row {
      fill: width
      gap: 8
      Column {
        weight: 1
        gap: 2
        Text { text: "Bitcoin Pulse"; font: sans; fontSize: 13; color: #BAC7DB; maxLines: 1 }
        Text { text: priceText; font: sans; fontSize: tileWidth < 340 ? 28 : 32; bold: true; color: #F7FAFF; maxLines: 1 }
      }
      Box {
        width: 60
        height: 48
        align: center
        background: #243246
        border: 1
        borderColor: #38485F
        radius: 12
        onTap: currency = currency == "EUR" ? "USD" : "EUR"
        Text { text: "${currency} ▾"; font: sans; fontSize: 13; color: #F7FAFF; align: center; maxLines: 1 }
      }
    }
    Text { text: change == null ? "Kraken · wacht op koers" : "${replace(fixed(change, 2), '.', ',')}% vandaag (UTC) · Kraken"; font: sans; fontSize: 12; color: change < 0 ? #FF647C : #35E89A; maxLines: 1 }
    Row {
      fill: width
      gap: 4
      padding: 3
      background: #0C1018
      radius: 12
      for p in [240, 1440, 10080] {
        Box {
          weight: 1
          height: 48
          align: center
          background: interval == p ? #FF8A1F : #0C1018
          radius: 9
          onTap: interval = p
          Text { text: p == 240 ? "4 uur" : p == 1440 ? "1 dag" : "1 week"; font: sans; fontSize: 13; bold: true; color: interval == p ? #17120D : #BAC7DB; align: center; maxLines: 1 }
        }
      }
    }
    Row {
      fill: width
      gap: 8
      align: center
      Column {
        weight: 1
        gap: 2
        Text { text: "Ichimoku cloud"; font: sans; fontSize: 13; color: #F7FAFF; maxLines: 1 }
        Text { text: ichimoku && !cloudReady ? "${cloudRequired} candles nodig · vernieuw" : "20 / 60 / 120 / 30"; font: sans; fontSize: 11; color: ichimoku && !cloudReady ? #FFD166 : #BAC7DB; maxLines: 1 }
      }
      Box {
        width: 76
        height: 48
        align: center
        background: #243246
        border: 1
        borderColor: ichimoku ? #FF8A1F : #38485F
        radius: 24
        onTap: ichimoku = !ichimoku
        Text { text: ichimoku ? "Cloud Aan" : "Cloud Uit"; font: sans; fontSize: 12; color: ichimoku ? #FF8A1F : #BAC7DB; align: center; maxLines: 1 }
      }
    }
    Row {
      fill: width
      align: center
      gap: 3
      Text { weight: 1; text: "${interval == 240 ? '4 uur' : interval == 1440 ? '1 dag' : '1 week'} · ${currency}"; font: sans; fontSize: 12; color: #BAC7DB; maxLines: 1 }
      Box {
        width: 40
        height: 40
        align: center
        onTap: {
          zoom4h = interval == 240 ? (zoom4h < 36 ? 36 : zoom4h < 60 ? 60 : 90) : zoom4h
          zoomDay = interval == 1440 ? (zoomDay < 36 ? 36 : zoomDay < 60 ? 60 : 90) : zoomDay
          zoomWeek = interval == 10080 ? (zoomWeek < 36 ? 36 : zoomWeek < 60 ? 60 : 90) : zoomWeek
        }
        Box { width: 30; height: 30; align: center; radius: 8; background: #243246; border: 1; borderColor: #38485F; Text { text: "−"; font: sans; fontSize: 20; color: zoomCount >= 90 ? #5F563F : #FF8A1F; align: center } }
      }
      Text { width: 26; text: str(len(chart)); font: sans; fontSize: 11; color: #F7FAFF; align: center; maxLines: 1 }
      Box {
        width: 40
        height: 40
        align: center
        onTap: {
          zoom4h = interval == 240 ? (zoom4h > 60 ? 60 : zoom4h > 36 ? 36 : 24) : zoom4h
          zoomDay = interval == 1440 ? (zoomDay > 60 ? 60 : zoomDay > 36 ? 36 : 24) : zoomDay
          zoomWeek = interval == 10080 ? (zoomWeek > 60 ? 60 : zoomWeek > 36 ? 36 : 24) : zoomWeek
        }
        Box { width: 30; height: 30; align: center; radius: 8; background: #243246; border: 1; borderColor: #38485F; Text { text: "+"; font: sans; fontSize: 20; color: zoomCount <= 24 ? #5F563F : #FF8A1F; align: center } }
      }
    }
    if len(chart) > 0 {
      Canvas {
        fill: width
        height: 116
        let plotWidth = max(width - 58, 1)
        let plotHeight = 82
        let top = 7
        let step = plotWidth / max(len(chart) + (cloudReady ? 29 : 0), 1)
        for j in [0, 1, 2] {
          let axisValue = high - span * j / 2
          let axisDigits = str(int(round(axisValue)))
          let axisText = join(reverse(map(range(ceil(len(axisDigits) / 3)), k => sub(axisDigits, max(0, len(axisDigits) - (k + 1) * 3), len(axisDigits) - k * 3))), ".")
          line(0, top + j * plotHeight / 2, plotWidth, top + j * plotHeight / 2, stroke: #38485F, width: 0.6)
          text(axisText, width, top + j * plotHeight / 2, size: 10, align: end, color: #BAC7DB)
        }
        let points = cloudPoints
        if len(points) > 1 {
          let edges = map(range(len(points)), j => {p: points[j], q: points[j + 1], t: j + 1 < len(points) && (points[j].a - points[j].b) * (points[j + 1].a - points[j + 1].b) < 0 ? (points[j].a - points[j].b) / ((points[j].a - points[j].b) - (points[j + 1].a - points[j + 1].b)) : null})
          let fillPoints = flatten(map(edges, r => r.t == null ? [r.p] : [r.p, {index: r.p.index + r.t, a: r.p.a + (r.q.a - r.p.a) * r.t, b: r.p.a + (r.q.a - r.p.a) * r.t}]))
          path(flatten([map(fillPoints, p => [(p.index + 0.5) * step, top + (high - p.a) / span * plotHeight]), reverse(map(fillPoints, p => [(p.index + 0.5) * step, top + (high - min(p.a, p.b)) / span * plotHeight]))]), closed: true, fill: alpha(#43A047,0.26))
          path(flatten([map(fillPoints, p => [(p.index + 0.5) * step, top + (high - p.a) / span * plotHeight]), reverse(map(fillPoints, p => [(p.index + 0.5) * step, top + (high - max(p.a, p.b)) / span * plotHeight]))]), closed: true, fill: alpha(#F23645,0.26))
          for p, j in points {
            if j < len(points) - 1 {
              let q = points[j + 1]
              line((p.index + 0.5) * step, top + (high - p.a) / span * plotHeight, (q.index + 0.5) * step, top + (high - q.a) / span * plotHeight, stroke: #A5D6A7, width: 1)
              line((p.index + 0.5) * step, top + (high - p.b) / span * plotHeight, (q.index + 0.5) * step, top + (high - q.b) / span * plotHeight, stroke: #EF9A9A, width: 1)
            }
          }
        }
        for c, i in chart {
          let x = (i + 0.5) * step
          let openY = top + (high - num(c[1])) / span * plotHeight
          let closeY = top + (high - num(c[4])) / span * plotHeight
          let rising = num(c[4]) >= num(c[1])
          line(x, top + (high - num(c[2])) / span * plotHeight, x, top + (high - num(c[3])) / span * plotHeight, stroke: rising ? #35E89A : #FF647C, width: 1)
          rect(x - step * 0.27, min(openY, closeY), step * 0.54, max(abs(openY - closeY), 1.5), fill: rising ? #182230 : #FF647C, stroke: rising ? #35E89A : #FF647C, width: 1)
        }
        text(fmtTime(num(first(chart)[0]), "d MMM"), 0, 107, size: 10, color: #BAC7DB)
        if !cloudReady {
          text(fmtTime(num(chart[floor(len(chart) / 2)][0]), "d MMM"), plotWidth / 2, 107, size: 10, align: center, color: #BAC7DB)
        }
        if cloudReady {
          text(fmtTime(num(last(chart)[0]), "d MMM"), (len(chart) - 0.5) * step, 107, size: 10, align: center, color: #BAC7DB)
          text("Cloud", plotWidth, 107, size: 10, align: end, color: #BAC7DB)
        } else {
          text(fmtTime(num(last(chart)[0]), "d MMM"), plotWidth, 107, size: 10, align: end, color: #BAC7DB)
        }
      }
      Text { text: "Laatste candle loopt nog · lokaal · ${fmtTime(candleAt, 'HH:mm')}"; font: sans; fontSize: 11; color: ohlc.ok == false || now - candleAt > 660 ? #FFD166 : #BAC7DB; maxLines: 1 }
    } else {
      Box {
        fill: width
        height: 137
        align: center
        Text { text: ohlc.ok == false || len(ohlc.out.error) > 0 ? "Candles niet beschikbaar · tik op ↻" : "Candles laden…"; font: sans; fontSize: 12; color: #FFD166; align: center; maxLines: 2 }
      }
    }
    Column {
      fill: width
      gap: 4
      padding: 10
      background: #243246
      radius: 14
      Row {
        fill: width
        gap: 6
        Text { text: "Blok #${heightText}"; weight: 1; font: sans; fontSize: 15; bold: true; color: #49CFFF; maxLines: 1 }
        Text { text: block == null ? "—" : "${fmtDuration(max(now - block.timestamp, 0))} geleden"; weight: 1; font: sans; fontSize: 12; color: #F7FAFF; align: end; maxLines: 1 }
      }
      Text { text: "${txText} transacties · ${block.extras.pool.name ?? 'Onbekende pool'}"; font: sans; fontSize: 12; color: #BAC7DB; maxLines: 1 }
      Text { text: block.extras.medianFee == null ? "Mediaan blokfee —" : "Mediaan blokfee ${replace(fixed(block.extras.medianFee, 1), '.', ',')} sat/vB"; font: sans; fontSize: 12; color: #BAC7DB; maxLines: 1 }
    }
    Column {
      fill: width
      gap: 4
      Text { text: "Fee-advies · schatting"; font: sans; fontSize: 11; color: #BAC7DB; maxLines: 1 }
      Row {
        fill: width
        gap: 6
        for f, i in [advice.fastestFee, advice.halfHourFee, advice.hourFee] {
          Column {
            weight: 1
            gap: 1
            Text { text: f == null ? "— sat/vB" : "${replace(str(num(f)), '.', ',')} sat/vB"; font: sans; fontSize: 16; bold: true; color: i == 0 ? #FF8A1F : #F7FAFF; maxLines: 1 }
            Text { text: i == 0 ? "Volgend blok" : i == 1 ? "~30 min" : "~1 uur"; font: sans; fontSize: 11; color: #BAC7DB; maxLines: 1 }
          }
        }
      }
    }
    Box { fill: width; height: 1; background: #38485F }
    Text { text: mem == null ? "Mempool laden…" : "Mempool ${int(mem.count)} tx · ${replace(fixed(mem.vsize / 1000000, 1), '.', ',')} vMB"; font: sans; fontSize: 12; color: #BAC7DB; maxLines: 1 }
    Row {
      fill: width
      gap: 8
      align: center
      Column {
        weight: 1
        gap: 2
        Text { text: failed ? "Bron niet bereikbaar · vorige waarden" : stale ? "Oudere waarden · controleer met ↻" : "Gewijzigd ${fmtTime(lastChange, 'HH:mm')}"; font: sans; fontSize: 12; color: failed || stale ? #FFD166 : #BAC7DB; maxLines: 1 }
        Text { text: "mempool.space · Kraken"; font: sans; fontSize: 11; color: #BAC7DB; maxLines: 1 }
      }
      Box {
        width: 48
        height: 48
        align: center
        background: #243246
        border: 1
        borderColor: #38485F
        radius: 14
        onTap: refresh()
        Text { text: "↻"; font: sans; fontSize: 30; color: #FF8A1F; align: center; maxLines: 1 }
      }
    }
  }
}
