<resources>
    <style name="PeriodButton" parent="WidgetLabel">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item><item name="android:gravity">center</item>
        <item name="android:background">@drawable/widget_inner</item>
        <item name="android:clickable">true</item><item name="android:focusable">true</item>
    </style>
    <style name="WidgetLabel">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#BAC7DB</item><item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans</item><item name="android:maxLines">1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="WidgetNumber" parent="WidgetLabel">
        <item name="android:textColor">#F7FAFF</item><item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item><item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="FeeColumn">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item><item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="ChartZoomButton" parent="WidgetLabel">
        <item name="android:layout_width">40dp</item><item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item><item name="android:textSize">20sp</item>
        <item name="android:textColor">#FF8A1F</item><item name="android:background">@drawable/widget_zoom_button</item>
        <item name="android:clickable">true</item><item name="android:focusable">true</item>
    </style>
    <style name="WidgetCountButton" parent="WidgetLabel">
        <item name="android:layout_width">88dp</item><item name="android:layout_height">44dp</item>
        <item name="android:gravity">center</item><item name="android:fontFamily">sans-serif</item><item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/widget_choice_off</item>
        <item name="android:clickable">true</item><item name="android:focusable">true</item>
    </style>
</resources>
